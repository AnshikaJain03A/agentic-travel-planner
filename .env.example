# ============================================================
#  Travel Planner - Environment Configuration
#  Copy this file to ".env" and fill in your real values.
# ============================================================

# ---- LLM Provider Selection ----
# Options: "openai", "anthropic" or "google" (Gemini)
LLM_PROVIDER=google

# Model names (override defaults if desired)

# Gemini models, e.g. gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3-pro-preview
GOOGLE_MODEL=gemini-3.5-flash

# Temperature for generation (0.0 - 1.0)
LLM_TEMPERATURE=0.4

# ---- API Keys ----

# Get a Gemini key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyA2B2XuOjsNWlbdQWFyCUPoY-G7AsNs5qA

# ---- Embeddings (used by ChromaDB RAG) ----
# OpenAI embeddings (used when provider=openai or as a fallback).

# Google embeddings (used when provider=google).
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Storage paths ----
SQLITE_DB_PATH=./data/travel_planner.db
CHROMA_PERSIST_DIR=./data/chroma
RAG_DOCS_DIR=./rag/documents

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Behavior ----
# When true, agents return deterministic mock data if no API key is configured.
# Useful for local development / running tests without spending tokens.
ALLOW_MOCK_FALLBACK=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
